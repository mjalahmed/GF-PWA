# GarageFinder Backend — server secrets (never commit real values)
# Copy to .env for local development

# Runtime
APP_ENV=development
PORT=8080
LOG_LEVEL=info
API_ROOT_PATH=

# CORS — comma-separated browser origins (required in staging/production)
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Supabase project (Auth + PostgREST + Storage — required at runtime)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Aliases also accepted:
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Railway PostgreSQL (migrations only — see docs/RAILWAY.md)
DATABASE_URL=

# Optional overrides
# GARAGEFINDER_API_URL=http://127.0.0.1:8080
