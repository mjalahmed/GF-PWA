# Public client env only — NEVER put SUPABASE_SERVICE_ROLE_KEY here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local GarageFinder API (backend: make serve on port 8080)
VITE_GARAGEFINDER_API_URL=http://127.0.0.1:8080

# Or Supabase Edge Functions URL:
# VITE_GARAGEFINDER_API_URL=https://your-project.supabase.co/functions/v1/api

VITE_APP_ENV=development
